<%# Changes from +/- on "Alle Produkter" wait here until they are approved. %>
<div
  id="pendingChanges"
  class="hidden fixed z-40 bottom-0 inset-x-0 sm:inset-x-auto sm:bottom-4 sm:right-4 sm:w-96 bg-white rounded-t-2xl sm:rounded-2xl shadow-xl border border-sky-200 p-3 sm:p-4"
>
  <div class="flex justify-between items-center mb-2">
    <h2 class="text-base sm:text-lg font-bold">Ændringer der venter</h2>
    <span id="pendingCount" class="text-xs text-slate-500"></span>
  </div>
  <ul id="pendingList" class="max-h-48 overflow-y-auto divide-y divide-slate-100 text-sm"></ul>
  <div class="flex gap-2 mt-3">
    <button type="button" id="pendingApprove" class="flex-1 bg-sky-600 text-white rounded-lg py-2.5 font-medium hover:bg-sky-700 disabled:opacity-50">Godkend</button>
    <button type="button" id="pendingCancel" class="flex-1 bg-gray-200 text-gray-800 rounded-lg py-2.5 font-medium hover:bg-gray-300">Annuller</button>
  </div>
</div>

<template id="pendingItemTemplate">
  <li class="flex items-center gap-2 py-1.5">
    <span class="flex-1 min-w-0 truncate font-medium pending-name"></span>
    <span class="text-slate-500 whitespace-nowrap pending-from-to"></span>
    <span class="font-bold whitespace-nowrap pending-delta"></span>
    <button type="button" class="text-slate-400 hover:text-red-600 px-1 pending-remove" title="Fjern ændring" aria-label="Fjern ændring">✕</button>
  </li>
</template>
