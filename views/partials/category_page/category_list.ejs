<div class="flex flex-row items-center gap-3 mt-2 bg-white w-full">
    <div class="flex-1 flex flex-row gap-2 p-2 overflow-x-auto scrollbar-thin scrollbar-thumb-blue-200 border border-gray-100 rounded-lg whitespace-nowrap">
        <% categories.forEach(category => { %>
            <button type="button" class="category-button shrink-0 inline-block px-3 py-2 text-sm font-medium text-blue-700 bg-blue-50 border border-blue-100 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all cursor-pointer shadow-sm" data-category-id="<%= category.id %>">
                <p><%- category.name %></p>
            </button>
        <% }); %>
    </div>
    
    <button id="updateCategoriesBtn" class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 active:bg-blue-800 transition-colors shadow-sm whitespace-nowrap">
        Opdater
    </button>
</div>