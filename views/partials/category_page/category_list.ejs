<div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-3 mt-2 bg-white w-full">
    <div class="flex-1 flex flex-row gap-1 sm:gap-2 p-1.5 sm:p-2 overflow-x-auto scrollbar-thin scrollbar-thumb-blue-200 border border-gray-100 rounded-lg whitespace-nowrap">
        <% categories.forEach(category => { %>
            <button type="button" class="category-button shrink-0 inline-block px-2 sm:px-3 py-1 sm:py-2 text-xs sm:text-sm md:text-base font-medium text-blue-700 bg-blue-50 border border-blue-100 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all cursor-pointer shadow-sm" data-category-id="<%= category.id %>">
                <p><%- category.name %></p>
            </button>
        <% }); %>
    </div>
    
    <button id="updateCategoriesBtn" class="px-4 sm:px-6 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 active:bg-blue-800 transition-colors shadow-sm whitespace-nowrap w-full sm:w-auto">
        Opdater
    </button>
</div>