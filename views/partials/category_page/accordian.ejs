
<div class="relative w-3/5">
    <button onclick="toggleDropdown('<%- category.id %>')"
        class="inline-flex justify-between items-center w-full px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
        <span><%- category.name %></span>
        <div class="flex items-center">
            <span
                class="mr-2 px-2 py-0.5 text-xs font-bold bg-blue-500 text-blue-50 rounded-full border border-blue-400">
                <%= category.products.length %>
            </span>
            <svg id="arrow-<%- category.id %>" class="w-5 h-5 transform transition-transform duration-200"
                fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                    d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                    clip-rule="evenodd" />
            </svg>
        </div>
    </button>
    <div id="dropdownMenu-<%- category.id %>"
        class="absolute z-10 w-full mt-1 bg-white border border-gray-200 divide-y divide-gray-100 rounded-md shadow-lg opacity-0 scale-95 pointer-events-none transition-all duration-200 ease-out origin-top">
        <div class="p-2 flex flex-wrap gap-2">
            <% category.products.forEach(function(product) { %>
                <% if (category.name==='Ukategoriseret' ) {%>
                    <div class="inline-block px-3 py-2 text-sm font-medium text-blue-700 bg-blue-50 border border-blue-100 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all cursor-pointer shadow-sm">
                        <p><%- product.name %></p>
                    </div>
                    <% } else {%>
                        <div class="inline-block px-3 py-2 text-sm font-medium text-gray-700">
                            <p><%- product.name %></p>
                        </div>
                        <% } %>
                    <% if (category.products.length===0) { %>
                        <div class="w-full px-4 py-2 text-sm text-gray-400 italic">No products found</div>
                <% } %>
            <% }); %>
        </div>
    </div>
</div>

<script>
    function toggleDropdown(id) {
        const menu = document.getElementById('dropdownMenu-' + id);
        const arrow = document.getElementById('arrow-' + id);

        menu.classList.toggle('opacity-0');
        menu.classList.toggle('scale-95');
        menu.classList.toggle('pointer-events-none');

        arrow.classList.toggle('rotate-180');
    }
</script>