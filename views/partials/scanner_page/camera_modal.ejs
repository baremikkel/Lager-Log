<div id="cameraModal" class="hidden fixed inset-0 bg-black/70 z-[60] flex items-stretch md:items-center justify-center md:p-4">
  <div class="camera-sheet bg-white w-full h-[100dvh] md:h-auto md:max-h-[90vh] md:max-w-lg md:rounded-2xl md:shadow-2xl overflow-hidden flex flex-col">
    <div class="px-3 md:p-6 flex flex-col min-h-0 flex-1">
      <div class="shrink-0 flex justify-between items-center mb-2">
        <h5 class="text-lg md:text-2xl font-bold text-gray-800">Scan med kamera</h5>
        <button type="button" id="cameraCloseButton" aria-label="Luk kamera"
          class="w-11 h-11 -mr-2 flex items-center justify-center text-3xl leading-none text-gray-400 hover:text-gray-600 active:text-gray-800">&times;</button>
      </div>
      <div class="relative bg-black rounded-lg overflow-hidden shrink-0 h-[38dvh] md:h-auto md:aspect-video">
        <video id="cameraVideo" class="w-full h-full object-cover" muted playsinline></video>
        <div id="cameraAimBox" class="pointer-events-none absolute inset-x-6 top-1/2 -translate-y-1/2 h-1/3 border-2 border-red-500/80 rounded-md transition-colors"></div>
      </div>
      <p id="cameraStatus" class="shrink-0 mt-2 min-h-6 text-base font-medium text-gray-700 text-center truncate"></p>
      <div class="shrink-0 mt-2 grid grid-cols-3 gap-2">
        <button type="button" id="cameraModeButton"
          class="camera-btn bg-green-400 text-white">
          Tilføj Mode
        </button>
        <button type="button" id="cameraSendButton"
          class="camera-btn bg-sky-600 hover:bg-sky-700 text-white">
          Send liste
        </button>
        <button type="button" id="cameraDoneButton"
          class="camera-btn bg-gray-700 hover:bg-gray-800 text-white">
          Luk
        </button>
      </div>
      <div class="mt-2 min-h-[6rem] flex-1 overflow-y-auto overscroll-contain border-t border-gray-200 pt-1">
        <p id="cameraListEmpty" class="text-sm text-gray-400 text-center py-4">Ingen varer på listen endnu</p>
        <div id="cameraListSlot"></div>
      </div>
    </div>
  </div>
</div>
