<template id="itemListTemplate">
  <div
    class="flex flex-col sm:flex-row gap-2 sm:gap-4 md:gap-10 rounded-2xl p-2 sm:p-3 md:p-4 bg-green-100 my-2 item-container items-start sm:items-center"
  >
    <h2 class="text-xs sm:text-sm md:text-lg lg:text-2xl w-full sm:w-1/3 font-semibold product-name"></h2>
    <h2 class="text-xs sm:text-sm md:text-lg lg:text-2xl w-full sm:w-1/3 font-semibold product-barcode"></h2>
    <div class="flex items-center gap-2 sm:gap-4 ml-0 sm:ml-16 w-full sm:w-1/4 counter">
      <button class="text-sm sm:text-lg md:text-xl lg:text-2xl px-2 py-1 sm:px-3 sm:py-1.5 bg-blue-500 text-white rounded hover:bg-blue-600 decrementBtn">-</button>
      <span class="text-sm sm:text-lg md:text-xl lg:text-2xl mx-2 sm:mx-3.5 count"></span>
      <button class="text-sm sm:text-lg md:text-xl lg:text-2xl px-2 py-1 sm:px-3 sm:py-1.5 bg-blue-500 text-white rounded hover:bg-blue-600 incrementBtn">+</button>
    </div>
  </div>
</template>
