<template id="itemListTemplate">
  <div
    class="flex flex-row flex-wrap md:flex-nowrap gap-x-3 gap-y-1 md:gap-10 rounded-2xl p-2 sm:p-3 md:p-4 bg-green-100 my-2 item-container items-center"
  >
    <h2 class="text-base md:text-lg lg:text-2xl flex-1 min-w-0 md:w-1/3 font-semibold product-name"></h2>
    <h2 class="text-xs md:text-lg lg:text-2xl order-last md:order-none w-full md:w-1/3 text-gray-500 md:text-current font-mono md:font-semibold product-barcode"></h2>
    <div class="flex items-center gap-2 sm:gap-4 ml-auto md:ml-16 md:w-1/4 counter">
      <button class="text-sm sm:text-lg md:text-xl lg:text-2xl px-2 py-1 sm:px-3 sm:py-1.5 bg-blue-500 text-white rounded hover:bg-blue-600 decrementBtn">-</button>
      <span class="text-sm sm:text-lg md:text-xl lg:text-2xl mx-2 sm:mx-3.5 count"></span>
      <button class="text-sm sm:text-lg md:text-xl lg:text-2xl px-2 py-1 sm:px-3 sm:py-1.5 bg-blue-500 text-white rounded hover:bg-blue-600 incrementBtn">+</button>
    </div>
  </div>
</template>
