<template id="itemListTemplate">
  <div
    class="space-y-4 flex gap-10 rounded-2xl p-4 bg-green-100 my-2 item-container"
  >
    <h2 class="text-2xl w-1/3 product-name"></h2>
    <h2 class="text-2xl w-1/3 product-barcode"></h2>
    <div class="ml-16 w-1/4 counter">
      <button class="text-2xl decrementBtn">-</button>
      <span class="text-2xl mx-3.5 count"></span>
      <button class="text-2xl incrementBtn">+</button>
    </div>
  </div>
</template>
