<div id="addProductModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-2 sm:p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all max-h-screen overflow-y-auto">
        <div class="p-3 sm:p-4 md:p-6">
            <div class="flex justify-between items-center mb-3 sm:mb-4">
                <h5 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-800">Stregkoden blev ikke fundet</h5>
                <button type="button" onclick="document.getElementById('addProductModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl sm:text-2xl">&times;</button>
            </div>

            <form id="addProductForm">
                <div class="space-y-3 sm:space-y-4">
                    <p class="text-xs sm:text-sm md:text-base text-gray-600">Det ligner ikke at denne varer er i databasen venligst tilføj den i formularen.</p>
                        <div>
                            <label class="block text-xs sm:text-sm md:text-base font-medium text-gray-700">Stregkode</label>
                            <input type="text" name="barcode" id="modalBarcode"
                                   class="mt-1 block w-full border border-gray-300 rounded-md p-1.5 sm:p-2 text-sm sm:text-base focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs sm:text-sm md:text-base font-medium text-gray-700">Produkt Navn</label>
                            <input type="text" name="name" id="modalProductName"
                                   class="mt-1 block w-full border border-gray-300 rounded-md p-1.5 sm:p-2 text-sm sm:text-base focus:ring-blue-500 focus:border-blue-500" 
                                   required autofocus>
                        </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <label class="block text-xs sm:text-sm md:text-base font-medium text-gray-700">Mængde pr stk</label>
                            <input type="number" name="units" id="modalUnits"
                                   class="mt-1 block w-full border border-gray-300 rounded-md p-1.5 sm:p-2 text-sm sm:text-base focus:ring-blue-500 focus:border-blue-500" 
                                   placeholder="e.g 12 æg i en bakke"
                                   min="1"
                                   value="1"
                                   required>
                        </div>
                    </div>
                </div>

                <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row justify-end gap-2 sm:space-x-3">
                    <button type="button" onclick="document.getElementById('addProductModal').classList.add('hidden')" 
                            class="px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition w-full sm:w-auto">
                        Annuller
                    </button>
                    <button type="submit" 
                            class="px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base bg-blue-600 text-white rounded-md hover:bg-blue-700 transition w-full sm:w-auto">
                        Tilføj Produkt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>