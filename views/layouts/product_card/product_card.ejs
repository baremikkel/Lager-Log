<div class="bg-sky-100 p-2 sm:p-3 md:p-4 rounded-2xl shadow-sm w-full lg:w-3/4" id="productContainer">
    <h2 class="text-lg sm:text-xl md:text-2xl font-bold mb-3 sm:mb-4"><%= title %></h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2 sm:gap-3">
        <% products.forEach(product => { %>
            <div class="bg-white p-2 sm:p-3 rounded-lg shadow-sm border border-sky-200 hover:border-sky-400 transition-all flex flex-col min-w-0 card" id="product_card_<%= product.id %>" data-stock="<%= product.stock %>" data-categories="<%= JSON.stringify(product.categories || []) %>">
                <h3 class="text-xs sm:text-[13px] md:text-[15px] font-bold text-slate-800 mb-1 leading-tight truncate" title="Produkt navn" id="product_name">
                    <%= product.product_name %>
                </h3>
            
                <div class="flex flex-col gap-y-1 sm:gap-y-2 pt-1 sm:pt-2 border-t border-slate-50">
                    <div>
                        <p class="text-[9px] sm:text-[10px] md:text-[11px] uppercase font-bold text-sky-500 tracking-tight">Stregkode</p>
                        <p class="text-[8px] sm:text-[9px] md:text-[10px] text-slate-600 font-mono truncate" id="product_barcode">
                            <%= product.product_barcode %>
                        </p>
                    </div>
                    
                    <p class="text-[9px] sm:text-[10px] md:text-[11px] uppercase font-bold text-sky-500 tracking-tight">Antal</p>
                    
                    <div class="flex flex-row items-center gap-0.5 sm:gap-1.5">
                        <div class="flex flex-col min-w-0">
                            <div class="flex flex-row gap-0.5 sm:gap-1 text-[7px] sm:text-[8px] md:text-[9px]">
                                <p class="text-slate-600 truncate leading-tight" id="product_stock">
                                    <%= product.stock | 0%>
                                </p>
                                <p class="text-slate-600 truncate leading-tight">pr enhed</p>
                                <p class="text-slate-600 truncate leading-tight product-amount" id="product_amount">
                                    <%= product.product_amount | 0 %>
                                </p>
                                <p class="text-slate-600 truncate leading-tight">enheder</p>
                            </div>
                            
                            <p class="text-[6px] sm:text-[7px] md:text-[8px] text-slate-400 truncate italic total-display">
                                 (<%= product.stock * product.product_amount | 0 %> stk på lager)
                            </p>
                        </div>
                    </div>
                        <div class="flex gap-0.5 sm:gap-1">
                            <button type="button" class="bg-sky-500 text-white w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-md hover:bg-sky-600 transition-colors text-xs sm:text-sm font-bold shadow-sm active:scale-95 increase-btn" data-product-id="<%= product.id %>">+</button>
                            <button type="button" class="bg-sky-500 text-white w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-md hover:bg-sky-600 transition-colors text-xs sm:text-sm font-bold shadow-sm active:scale-95 decrease-btn" data-product-id="<%= product.id %>">-</button>
                        </div>
                </div>
            </div>
        <% }) %>
    </div> </div>

<%- include('./edit_modal') %>