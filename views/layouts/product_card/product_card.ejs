<div class="bg-sky-100 p-4 rounded-2xl shadow-sm w-3/4 grid grid-cols-5 gap-3" id="productContainer">
    <% products.forEach(product => { %>
        <div class="bg-white p-3 my-3 rounded-lg shadow-sm border border-sky-200 hover:border-sky-400 transition-all flex flex-col min-w-0" id="product_card_<%= product.id %>">
        <h3 class="text[15px] font-bold text-slate-800 mb-1 leading-tight truncate" title="Produkt navn"><%= product.product_name %></h3>
        
        <div class="flex flex-col gap-y-2 pt-2 border-t border-slate-50">
            <div>
                <p class="text-[12px] uppercase font-bold text-sky-500 tracking-tight">Stregkode</p>
                <p class="text-[11px] text-slate-600 font-mono truncate"><%= product.product_barcode %></p>
            </div>
            <div>
                <p class="text-[12px] uppercase font-bold text-sky-500 tracking-tight">Antal per produkt</p>
                <p class="text-[11px] text-slate-600 truncate"><%= product.stock%> stk</p>
            </div>
        </div>
    </div>
    <% }) %>
</div>