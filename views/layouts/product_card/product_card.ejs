<div class="bg-sky-100 p-2 sm:p-3 md:p-4 rounded-2xl shadow-sm w-full lg:w-3/4" id="productContainer">
    <h2 class="text-lg sm:text-xl md:text-2xl font-bold mb-3 sm:mb-4"><%= title %></h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2 sm:gap-3">
        <% products.forEach(product => {
            const perPackage = Number(product.stock) || 1;
            const amount = Number(product.product_amount) || 0;
            const fullPackages = Math.floor(amount / perPackage);
            const loose = amount % perPackage;
            const packageText = perPackage <= 1 ? '' :
                `= ${fullPackages} ${fullPackages === 1 ? 'pakke' : 'pakker'} à ${perPackage}` + (loose > 0 ? ` + ${loose} løse` : '');
        %>
            <div class="bg-white p-2 sm:p-3 rounded-lg shadow-sm border border-sky-200 hover:border-sky-400 transition-all flex flex-col min-w-0 card" id="product_card_<%= product.id %>" data-stock="<%= perPackage %>" data-amount="<%= amount %>" data-categories="<%= JSON.stringify(product.categories || []) %>">
                <h3 class="text-sm md:text-[15px] font-bold text-slate-800 mb-1 leading-tight truncate" title="Produkt navn" id="product_name">
                    <%= product.product_name %>
                </h3>
            
                <div class="flex flex-col gap-y-1 sm:gap-y-2 pt-1 sm:pt-2 border-t border-slate-50">
                    <div>
                        <p class="text-[11px] uppercase font-bold text-sky-500 tracking-tight">Stregkode</p>
                        <p class="text-xs md:text-[11px] text-slate-600 font-mono truncate" id="product_barcode">
                            <%= product.product_barcode %>
                        </p>
                    </div>
                    
                    <p class="text-[11px] uppercase font-bold text-sky-500 tracking-tight">Antal</p>
                    
                    <div class="flex flex-row items-center gap-0.5 sm:gap-1.5">
                        <div class="flex flex-col min-w-0">
                            <button type="button" class="stock-toggle text-left text-sm md:text-xs text-slate-700 leading-tight <%= packageText ? 'cursor-pointer underline decoration-dotted underline-offset-2 hover:text-sky-700' : 'cursor-default' %>" title="Vis antal pakker">
                                <span class="font-bold product-amount"><%= amount %></span> stk på lager
                            </button>
                            <p class="text-[11px] md:text-[10px] text-slate-500 truncate leading-tight package-display hidden"><%= packageText %></p>
                            <p class="text-[11px] md:text-[10px] text-slate-400 truncate italic product-per-package"><%= perPackage %> stk pr pakke</p>
                        </div>
                    </div>
                        <div class="flex gap-2 md:gap-1 mt-1">
                            <button type="button" class="bg-sky-500 text-white flex-1 md:flex-none h-10 md:w-7 md:h-7 flex items-center justify-center rounded-md hover:bg-sky-600 transition-colors text-lg md:text-sm font-bold shadow-sm active:scale-95 increase-btn" data-product-id="<%= product.id %>">+</button>
                            <button type="button" class="bg-sky-500 text-white flex-1 md:flex-none h-10 md:w-7 md:h-7 flex items-center justify-center rounded-md hover:bg-sky-600 transition-colors text-lg md:text-sm font-bold shadow-sm active:scale-95 decrease-btn" data-product-id="<%= product.id %>">-</button>
                        </div>
                </div>
            </div>
        <% }) %>
    </div> </div>

<%- include('./edit_modal') %>